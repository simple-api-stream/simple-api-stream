{
  "name": "simple-api-stream",
  "private": true,
  "version": "1.0.0",
  "description": "SimpleAPI+{Writable|Readable}Streams monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:watch": "vitest watch --coverage",
    "test": "vitest run --coverage --coverage.reporter=cobertura --coverage.reporter=text",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "build": "npm run build -w @simple-api-stream/core && npm run build -w @simple-api-stream/json && npm run build -w @simple-api-stream/xml",
    "clean": "npm run clean --workspaces && node utils/remove.ts -- -f ./TestResults"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juner/simple-api-stream.git"
  },
  "author": "juners",
  "license": "MIT",
  "engines": {
    "node": ">=24.x"
  },
  "bugs": {
    "url": "https://github.com/juner/simple-api-stream/issues"
  },
  "homepage": "https://github.com/juner/simple-api-stream#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
